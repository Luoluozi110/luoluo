  "signatureTemplates": {
    "sig_style_mastery": {
      "name": "文体专精",
      "category": "style",
      "trigger": {
        "npcStyle": "{style}"
      },
      "effect": {
        "type": "pct",
        "value": "{pct}"
      },
      "stack": "none",
      "intentBias": {
        "style": "{style}",
        "weight": "{bias}"
      },
      "description": "{name}使用{styleName}时，作品总分提高{pctP}。"
    },
    "sig_repeat_read": {
      "name": "识破重复",
      "category": "behavior",
      "trigger": {
        "playerLastStyleSame": true
      },
      "effect": {
        "type": "pct",
        "value": "{pct}"
      },
      "stack": "once",
      "firstBattle": "disabled",
      "description": "玩家本场文体与上一场相同时，{name}作品总分提高{pctP}。"
    },
    "sig_dice_response": {
      "name": "追加骰响应",
      "category": "resource",
      "trigger": {
        "playerExtraDice": ">=1"
      },
      "effect": {
        "type": "flat_steps",
        "steps": "{steps}",
        "cap": "{cap}"
      },
      "stack": "per_dice_decaying",
      "altAction": {
        "trigger": "playerExtraDice>=1",
        "switchTo": "strong_attack"
      },
      "description": "玩家每追加一枚灵感骰，{name}获得递减临场分（{steps}），封顶{cap}。"
    },
    "sig_copycat": {
      "name": "仿作惯用",
      "category": "behavior",
      "trigger": {
        "playerHabitualStyle": "{style}",
        "playerUses": "{style}"
      },
      "effect": {
        "type": "pct",
        "value": "{pct}"
      },
      "historyLen": 2,
      "noHistory": "fallback_preferred",
      "description": "玩家近两场惯用{styleName}且本场继续使用时，{name}作品总分提高{pctP}。"
    },
    "sig_debt_drain": {
      "name": "文债耗神",
      "category": "resource",
      "trigger": {
        "afterBattle": true,
        "playerWinMarginLt": "{threshold}"
      },
      "effect": {
        "type": "inspiration",
        "value": "-{cost}",
        "maxCost": "{cost}"
      },
      "description": "战后若玩家未以{thresholdP}以上分差获胜，则灵感-{cost}。"
    },
    "sig_steady_pressure": {
      "name": "稳稿压迫",
      "category": "defense",
      "trigger": {
        "always": true
      },
      "effect": {
        "type": "flat_floor",
        "value": "{floor}"
      },
      "cost": {
        "npcCeiling": "-{ceiling}"
      },
      "description": "{name}本场发挥下限提升{floor}分，但爆发上限降低{ceiling}分。"
    },
    "sig_manner_theme": {
      "name": "文风立意",
      "category": "manner",
      "trigger": {
        "npcMannerIn": "{manners}",
        "themeMatch": "preferred"
      },
      "effect": {
        "type": "pct",
        "value": "{pct}",
        "applyTo": "si_contribution"
      },
      "description": "{name}使用{mannerNames}等立意文风时，思力贡献提高，等效总分约{pctP}。"
    },
    "sig_palace_adapt": {
      "name": "跨场适应",
      "category": "cross_battle",
      "trigger": {
        "palaceNext": true,
        "playerExploitedWeakness": true
      },
      "effect": {
        "type": "adapt_layer",
        "maxLayers": 2,
        "perLayer": 1,
        "weaknessDampen": 2500,
        "minWeaknessRetention": 5000
      },
      "description": "殿试中{name}会根据上一场战况调整意图，重复破绽收益降低但保留至少一半。"
    },
    "sig_zeitgeist_surf": {
      "name": "借风成势",
      "category": "environment",
      "trigger": {
        "npcMannerMatchesZeitgeist": true
      },
      "effect": {
        "type": "pct",
        "value": "{pct}"
      },
      "stack": "none",
      "description": "{name}顺应当朝得势文风时，作品总分提高{pctP}。"
    },
    "sig_active_talent_tax": {
      "name": "截脉问锋",
      "category": "talent",
      "trigger": {
        "playerActiveTalentUsed": true
      },
      "effect": {
        "type": "pct",
        "value": "{pct}"
      },
      "stack": "once",
      "description": "玩家发动主动文心后，{name}乘势追问，作品总分提高{pctP}。"
    },
    "sig_dice_pattern_hunt": {
      "name": "审律摘瑕",
      "category": "dice_pattern",
      "trigger": {
        "playerDicePattern": "{pattern}"
      },
      "effect": {
        "type": "pct",
        "value": "{pct}"
      },
      "stack": "once",
      "description": "玩家骰组落入公开的{patternName}章法时，{name}作品总分提高{pctP}。"
    },
    "sig_declared_stance": {
      "name": "先声定策",
      "category": "strategy",
      "trigger": {
        "publicStance": true
      },
      "effect": {
        "type": "pct",
        "value": "{pct}"
      },
      "stack": "none",
      "description": "{name}已公开本场战策，若未被针对，作品总分提高{pctP}。"
    }
  },
  "weaknessTemplates": {
    "wea_use_other_style": {
      "name": "改用他体",
      "category": "style",
      "condition": {
        "playerStyle": "!={npcStyle}"
      },
      "primary": {
        "shutdownSignature": "{mainSig}",
        "retention": "{retention}"
      },
      "secondary": {
        "playerStyle": "{altStyle}",
        "shutdownSignature": "{mainSig}",
        "retention": 0
      },
      "playerBonus": {
        "type": "pct",
        "value": "{bonus}"
      },
      "description": "使用{altStyleName}可完全关闭「{sigName}」；使用{otherStyleName}可削弱至{retentionP}。"
    },
    "wea_switch_style": {
      "name": "主动换体",
      "category": "behavior",
      "condition": {
        "playerStyleChangedFromLast": true
      },
      "primary": {
        "shutdownSignature": "{mainSig}",
        "retention": 0
      },
      "infoBonus": {
        "intentPrecision": 1
      },
      "description": "本场文体与上一场不同时，关闭「{sigName}」并提升意图信息精度。"
    },
    "wea_base_dice_only": {
      "name": "只用基础骰",
      "category": "resource",
      "condition": {
        "playerExtraDice": 0
      },
      "primary": {
        "shutdownSignature": "{mainSig}",
        "flatPenalty": "{flat}"
      },
      "description": "玩家不追加灵感骰时，{name}失去{flat}分稳定分，且资源型招牌不触发。"
    },
    "wea_style_manner_combo": {
      "name": "文体＋文风组合",
      "category": "combo",
      "condition": {
        "playerStyle": "{style}",
        "playerMannerIn": "{manners}"
      },
      "primary": {
        "shutdownSignature": "{mainSig}",
        "retention": "{retention}"
      },
      "playerBonus": {
        "type": "pct",
        "value": "{bonus}"
      },
      "fallback": {
        "partial": "满足一项时削弱30%"
      },
      "description": "使用{styleName}并搭配{mannerNames}方向时，「{sigName}」削弱至{retentionP}。"
    },
    "wea_crushing_win": {
      "name": "高分差压卷",
      "category": "result",
      "condition": {
        "playerWin": true,
        "relativeMargin": ">={threshold}"
      },
      "primary": {
        "shutdownSignature": "{mainSig}",
        "refundInspiration": "{refund}"
      },
      "description": "以{thresholdP}以上分差获胜时，关闭「{sigName}」并返还最多{refund}点灵感。"
    },
    "wea_harmonious_manner": {
      "name": "相得文风破立意",
      "category": "manner",
      "condition": {
        "playerMannerIn": "{manners}",
        "mannerAffinity": ">=0"
      },
      "primary": {
        "shutdownSignature": "{mainSig}",
        "retention": "{retention}"
      },
      "altCondition": {
        "playerStyle": "ci",
        "extraShutdown": 1000
      },
      "fallback": {
        "useBestManner": "削弱30%"
      },
      "description": "使用与题材相得/契合且为{mannerNames}方向的文风时，「{sigName}」削弱至{retentionP}。"
    },
    "wea_counter_intent": {
      "name": "识别主要意图",
      "category": "information",
      "condition": {
        "playerMatchesIntentCounter": true
      },
      "primary": {
        "cancelAltAction": true,
        "weakenSignature": "{retention}"
      },
      "description": "针对当前主要意图采取公开反制时，取消备选行动并削弱招牌。"
    },
    "wea_cross_battle_shift": {
      "name": "跨场换策",
      "category": "cross_battle",
      "condition": {
        "palaceNext": true,
        "playerChangedStrategy": true
      },
      "primary": {
        "removeAdaptLayer": "{layerReduce}"
      },
      "description": "下一场改变文体/文风/资源打法时，移除一层跨场适应的{layerReduceP}收益。"
    },
    "wea_go_against_zeitgeist": {
      "name": "逆潮立骨",
      "category": "environment",
      "condition": {
        "playerMannerNotZeitgeist": true,
        "baseAffinity": ">={minAffinity}"
      },
      "primary": {
        "shutdownSignature": "{mainSig}",
        "retention": "{retention}"
      },
      "playerBonus": {
        "type": "pct",
        "value": "{bonus}"
      },
      "description": "不随当朝风潮、却仍以相得文风切题时，可削弱「{sigName}」并获得创见加成。"
    },
    "wea_hold_active_talent": {
      "name": "藏锋守拙",
      "category": "talent",
      "condition": {
        "playerActiveTalentUsed": false
      },
      "primary": {
        "shutdownSignature": "{mainSig}",
        "retention": "{retention}"
      },
      "playerBonus": {
        "type": "pct",
        "value": "{bonus}"
      },
      "description": "本场不用主动文心，令「{sigName}」无从借题发挥。"
    },
    "wea_limited_extra_dice": {
      "name": "收束成篇",
      "category": "resource",
      "condition": {
        "playerExtraDice": "<={maxExtraDice}"
      },
      "primary": {
        "shutdownSignature": "{mainSig}",
        "retention": "{retention}"
      },
      "playerBonus": {
        "type": "pct",
        "value": "{bonus}"
      },
      "description": "将追加骰控制在{maxExtraDice}枚以内，避开「{sigName}」审视的骰组花样。"
    },
    "wea_stance_counter": {
      "name": "对策破锋",
      "category": "information",
      "condition": {
        "counterPublicStance": true
      },
      "primary": {
        "shutdownSignature": "{mainSig}",
        "retention": "{retention}"
      },
      "playerBonus": {
        "type": "pct",
        "value": "{bonus}"
      },
      "description": "按其公开战策选择对应章法，可削弱「{sigName}」。"
    }
  },
  "intentTemplates": {
    "int_preferred_style": {
      "name": "偏好文体意图",
      "type": "style",
      "candidates": [
        "shi",
        "ci",
        "lian"
      ],
      "baseWeight": "expected_score",
      "signatureBias": {
        "style": "{style}",
        "mult": "{bias}"
      },
      "bottom": "{bottom}",
      "altAction": null,
      "description": "{name}本场倾向于使用{styleName}。"
    },
    "int_manner_theme": {
      "name": "文风立意意图",
      "type": "manner",
      "candidates": "manners",
      "baseWeight": "affinity_plus_si",
      "signatureBias": {
        "mannerIn": "{manners}",
        "mult": "{bias}"
      },
      "bottom": "{bottom}",
      "disclosure": "category",
      "description": "{name}本场重立意，倾向{mannerNames}方向。"
    },
    "int_steady": {
      "name": "稳守意图",
      "type": "strategy",
      "strategy": "steady",
      "signatureBias": {
        "template": "sig_steady_pressure"
      },
      "disclosure": "action",
      "description": "{name}本场准备稳守，降低波动。"
    },
    "int_dice_response": {
      "name": "追加骰响应意图",
      "type": "reactive",
      "mainAction": {
        "style": "preferred"
      },
      "altAction": {
        "trigger": "playerExtraDice>=1",
        "switchTo": "strong_attack"
      },
      "disclosure": "full",
      "description": "{name}本场正常应战；若玩家追加骰，则转为强攻。"
    },
    "int_copycat": {
      "name": "仿作意图",
      "type": "history",
      "historyLen": 2,
      "mainAction": {
        "style": "playerHabitual"
      },
      "noHistory": {
        "fallback": "int_preferred_style",
        "style": "{style}"
      },
      "disclosure": "category",
      "description": "{name}准备模仿你近日常用路数。"
    },
    "int_palace_adapt": {
      "name": "殿试适应意图",
      "type": "cross_battle",
      "historySource": [
        "lastBattle"
      ],
      "firstBattle": {
        "fallback": "int_preferred_style"
      },
      "disclosure": "category",
      "description": "{name}已根据上一场战况调整策略。"
    },
    "int_zeitgeist": {
      "name": "逐潮意图",
      "type": "zeitgeist",
      "disclosure": "full",
      "description": "{name}本场顺应当朝风潮，以得势文风行文。"
    },
    "int_active_watch": {
      "name": "封心意图",
      "type": "active_watch",
      "disclosure": "action",
      "description": "{name}本场紧盯主动文心的起落。"
    },
    "int_pattern_hunt": {
      "name": "审律意图",
      "type": "pattern",
      "disclosure": "full",
      "description": "{name}本场专审玩家公开的骰组章法。"
    },
    "int_declared_stance": {
      "name": "定策意图",
      "type": "stance",
      "disclosure": "full",
      "description": "{name}已公开本场战策，邀你正面拆解。"
    }
  }
}
