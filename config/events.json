    "choices": [
      { "text": "就地讲了半个时辰，日头都偏了", "effect": { "attrs": { "xue": 2, "si": 1 }, "inspiration": 1 } },
      { "text": "念完便走，赶路要紧", "effect": { "attrs": { "xue": 1 }, "inspiration": 0 } }
