[
  {
    "id": "E001",
    "name": "梦笔生花",
    "rarity": "legend",
    "kind": "direct",
    "text": "夜宿江畔驿馆，梦中所执之笔头上忽然生出花来。醒后握管，字字如有神助。《开元天宝遗事》记李白少时正有此梦，自此天才赡逸，名闻天下。",
    "effect": { "attrs": { "bi": 5 }, "inspiration": 0, "talent": "T007" }
  },
  {
    "id": "E002",
    "name": "洛阳纸贵",
    "rarity": "legend",
    "kind": "direct",
    "text": "你的旧作被人抄去传阅，一日之间满城竞相摹写，纸价为之腾涌。当年左思十年成《三都赋》，豪贵之家争相传写，洛阳为之纸贵——今日轮到你了。",
    "effect": { "attrs": { "xue": 4, "bi": 2 }, "inspiration": 3 }
  },
  {
    "id": "E003",
    "name": "兰亭修禊",
    "rarity": "legend",
    "kind": "challenge",
    "text": "暮春之初，会于会稽山阴之兰亭。曲水流觞，觞停于谁前，谁便须赋诗一首，作不出者罚酒三斗。今日觞停了三次，都停在你面前。",
    "challenge": { "battles": 3, "winAll": { "attrs": { "bi": 5, "si": 3 }, "talent": "T015" } }
  },
  {
    "id": "E004",
    "name": "谪仙人",
    "rarity": "legend",
    "kind": "direct",
    "text": "旅次遇一白发老者，索观你的近作，读罢长揖：「子非人世中人，得非太白星精耶？」——当年贺知章读《蜀道难》，便是这样称李白为「谪仙人」的。",
    "effect": { "attrs": { "shi": 5 }, "inspiration": 2, "talent": "T012" }
  },
  {
    "id": "E005",
    "name": "斗酒百篇",
    "rarity": "rare",
    "kind": "challenge",
    "text": "「李白斗酒诗百篇，长安市上酒家眠。」酒肆中三位狂客拍案而起，要与你连比三场。酒已温好，笔已蘸墨——敢不敢接？",
    "challenge": { "battles": 3, "winAll": { "attrs": { "shi": 5 }, "inspiration": 2 } }
  },
  {
    "id": "E006",
    "name": "江郎才尽",
    "rarity": "rare",
    "kind": "choice",
    "text": "夜梦一人自称郭璞，向你索还那支寄放多年的五色笔。《南史》载江淹还笔之后，为诗绝无美句，时人谓之才尽。笔在你手，还是不还？",
    "choices": [
      { "text": "还他五色笔，从此老实读书", "effect": { "attrs": { "si": 3 }, "inspiration": -2 } },
      { "text": "强留彩笔，搜尽枯肠再赋一篇", "effect": { "attrs": { "bi": 4 }, "inspiration": -4 } }
    ]
  },
  {
    "id": "E007",
    "name": "一字之师",
    "rarity": "rare",
    "kind": "choice",
    "text": "你把新作示人，对方沉吟良久，只改了一个字。当年齐己《早梅》原作「前村深雪里，昨夜数枝开」，郑谷改「数枝」为「一枝」，齐己下拜，世称一字师。改，还是不改？",
    "choices": [
      { "text": "长揖称谢，从此虚心求教", "effect": { "attrs": { "xue": 3, "si": 2 }, "inspiration": 1 } },
      { "text": "自恃己见，仍用原句", "effect": { "attrs": { "bi": 2 }, "inspiration": 0 } }
    ]
  },
  {
    "id": "E008",
    "name": "铁杵磨针",
    "rarity": "rare",
    "kind": "direct",
    "text": "溪畔见一老媪持铁杵在石上磨，问之，曰：「欲作针。」你怔在原地，忽然明白自己欠缺的从来不是天分。",
    "effect": { "attrs": { "bi": 3, "si": 2 }, "inspiration": 1 }
  },
  {
