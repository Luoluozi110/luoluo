.school {
  min-height: 100vh;
  padding: 48rpx 40rpx 64rpx;
  box-sizing: border-box;
}

.school__title {
  font-size: 44rpx;
  font-weight: 500;
}

.school__sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--fh-ink-soft);
}

.school__loading {
  margin-top: 80rpx;
  text-align: center;
  color: var(--fh-ink-soft);
}

.school__list {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.school__card {
  padding: 32rpx;
  transition: transform 0.15s ease;
}

.school__card--hover {
  transform: translateY(-4rpx);
}

.school__name {
  font-size: 36rpx;
  font-weight: 500;
}

.school__desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--fh-ink-soft);
}

.school__enter {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--fh-seal);
}

.school__back {
  margin-top: 48rpx;
}
