.lo {
  min-height: 100vh;
  padding: 40rpx 32rpx 64rpx;
  box-sizing: border-box;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.lo__title {
  font-size: 44rpx;
  font-weight: 500;
}

.lo__sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--fh-ink-soft);
}

.lo__count {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--fh-ink-soft);
}

.lo__num {
  color: var(--fh-seal);
  font-size: 32rpx;
}

.lo__empty {
  margin-top: 32rpx;
  padding: 28rpx;
  font-size: 26rpx;
  line-height: 1.8;
  background: var(--fh-paper-raised);
  border-left: 4rpx solid var(--fh-seal);
  border-radius: 8rpx;
}

.lo__list {
  margin-top: 32rpx;
}

.card {
  margin-bottom: 20rpx;
  background: var(--fh-paper-raised);
  border: 0.5px solid var(--fh-line);
  border-radius: 16rpx;
  padding: 24rpx;
}

.card--locked {
  opacity: 0.6;
}

.card--chosen {
  border-color: var(--fh-seal);
}

.card__head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.card__left {
  flex: 1;
  min-width: 0;
}

.card__name {
  font-size: 32rpx;
  font-weight: 500;
}

.card__reward {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--fh-ink-soft);
  line-height: 1.6;
}

.card__state {
  flex-shrink: 0;
}

.card__tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  border-radius: 6rpx;
  background: var(--fh-seal);
  color: #ffffff;
}

.card__tag--idle {
  background: rgba(92, 84, 72, 0.1);
  color: var(--fh-ink-soft);
}

.card__tag--lock {
  background: rgba(92, 84, 72, 0.08);
  color: var(--fh-ink-soft);
}

.card__more {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--fh-seal);
}

.card__text {
  margin-top: 16rpx;
  padding: 20rpx;
  font-size: 25rpx;
  line-height: 1.9;
  background: rgba(92, 84, 72, 0.05);
  border-radius: 8rpx;
}

.card__branch {
  margin-top: 20rpx;
}

.card__branch-title {
  font-size: 24rpx;
  color: var(--fh-ink-soft);
}

.branch {
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  border: 0.5px solid var(--fh-line);
  border-radius: 10rpx;
}

.branch--on {
  border-color: var(--fh-seal);
  background: rgba(178, 58, 46, 0.06);
}

.branch--off {
  opacity: 0.5;
}

.branch__name {
  font-size: 27rpx;
  font-weight: 500;
}

.branch__need {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--fh-ink-soft);
}

.branch__desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--fh-ink-soft);
}

.lo__name {
  margin-top: 40rpx;
}

.lo__name-label {
  font-size: 26rpx;
  color: var(--fh-ink-soft);
}

.lo__name-input {
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
  background: var(--fh-paper-raised);
  border: 0.5px solid var(--fh-line);
  border-radius: 12rpx;
  font-size: 30rpx;
}

.lo__actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
