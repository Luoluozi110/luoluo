.board-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.hud {
  padding: 24rpx;
  background: var(--fh-paper-raised);
  border: 0.5px solid var(--fh-line);
  border-radius: 16rpx;
}

.hud__top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.hud__title {
  font-size: 32rpx;
  font-weight: 500;
}

.hud__turn {
  font-size: 26rpx;
  color: var(--fh-ink-soft);
}

.hud__insp {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hud__label {
  font-size: 24rpx;
  color: var(--fh-ink-soft);
}

.hud__bar {
  flex: 1;
  height: 12rpx;
  background: rgba(92, 84, 72, 0.12);
  border-radius: 6rpx;
  overflow: hidden;
}

.hud__bar-fill {
  height: 100%;
  background: var(--fh-seal);
}

.hud__num {
  font-size: 24rpx;
  min-width: 100rpx;
  text-align: right;
}

.hud__attrs {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 8rpx;
}

.attr {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.attr__label {
  font-size: 22rpx;
  color: var(--fh-ink-soft);
}

.attr__value {
  font-size: 30rpx;
  font-weight: 500;
}

.hud__meta {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--fh-ink-soft);
}

.log {
  margin-top: 24rpx;
  flex: 1;
  min-height: 320rpx;
  max-height: 44vh;
  padding: 20rpx;
  background: var(--fh-paper-raised);
  border: 0.5px solid var(--fh-line);
  border-radius: 16rpx;
}

.log__row {
  display: flex;
  gap: 16rpx;
  padding: 6rpx 0;
  font-size: 24rpx;
  line-height: 1.6;
}

.log__turn {
  color: var(--fh-seal);
  min-width: 56rpx;
}

.log__text {
  flex: 1;
  color: var(--fh-ink);
}

.toast {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  background: var(--fh-paper-raised);
  border-left: 4rpx solid var(--fh-seal);
  border-radius: 8rpx;
}

.actions {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.result {
  flex: 1;
  padding: 40rpx 32rpx;
}

.result__head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.result__title {
  font-size: 40rpx;
  font-weight: 500;
}

.result__grade {
  font-size: 30rpx;
  color: var(--fh-seal);
}

.result__total {
  margin-top: 32rpx;
  font-size: 56rpx;
  font-weight: 500;
}

.result__dim {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: var(--fh-paper-raised);
  border-radius: 8rpx;
  font-size: 26rpx;
}

.result__epilogue {
  margin-top: 32rpx;
  padding: 24rpx;
  font-size: 26rpx;
  line-height: 1.9;
  background: var(--fh-paper-raised);
  border: 0.5px solid var(--fh-line);
  border-radius: 12rpx;
  white-space: pre-wrap;
}

.result__back {
  margin-top: 48rpx;
}
