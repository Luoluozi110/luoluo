.rk {
  min-height: 100vh;
  padding: 40rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.rk__title {
  font-size: 44rpx;
  font-weight: 500;
}

.rk__sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--fh-ink-soft);
}

.mine {
  margin-top: 28rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  background: rgba(178, 58, 46, 0.06);
  border: 0.5px solid var(--fh-seal);
  border-radius: 12rpx;
}

.mine__rank {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--fh-seal);
}

.mine__score {
  font-size: 32rpx;
}

.offline {
  margin-top: 32rpx;
  padding: 32rpx;
  background: var(--fh-paper-raised);
  border: 0.5px solid var(--fh-line);
  border-radius: 16rpx;
}

.offline__title {
  font-size: 30rpx;
}

.offline__best {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 500;
  color: var(--fh-seal);
}

.offline__hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--fh-ink-soft);
}

.offline__retry {
  margin-top: 28rpx;
}

.rk__loading,
.rk__empty {
  margin-top: 80rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--fh-ink-soft);
}

.rk__list {
  margin-top: 28rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 12rpx;
  background: var(--fh-paper-raised);
  border: 0.5px solid var(--fh-line);
  border-radius: 12rpx;
}

.row--me {
  border-color: var(--fh-seal);
}

.row__rank {
  min-width: 56rpx;
  font-size: 30rpx;
  color: var(--fh-ink-soft);
}

.row__who {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.row__name {
  font-size: 29rpx;
}

.row__grade {
  font-size: 22rpx;
  color: var(--fh-ink-soft);
}

.row__score {
  font-size: 32rpx;
  font-weight: 500;
}

.rk__more {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--fh-ink-soft);
}

.rk__back {
  margin-top: 40rpx;
}
